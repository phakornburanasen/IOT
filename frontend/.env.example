# Optional override. By default the app uses:
# http://${window.location.hostname}:8000/api/RFID/api
# VITE_API_BASE_URL=http://gateway-host:8000/api/RFID/api

# Fallback refresh for the visible data (milliseconds).
VITE_AUTO_REFRESH_MS=15000

# Used only by Vite development server proxy.
VITE_DEV_API_TARGET=http://gateway-host:8000
