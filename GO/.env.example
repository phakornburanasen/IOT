# HTTP server
APP_HOST=0.0.0.0
APP_PORT=5108
API_PREFIX=/api
ALLOWED_ORIGINS=*
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s

# SQL Server (required)
DB_SERVER=sql-server-host
DB_PORT=1433
DB_NAME=database-name
DB_USER=database-user
DB_PASSWORD=change-me
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# Automatic database change detection
CHANGE_POLL_INTERVAL=2s
PING_TIMEOUT=2s
PING_WORKERS=16
